---
/*
 * =========================================================================
 * EMAIL SIGNUP PLACEHOLDER
 * =========================================================================
 * This is a non-functional shell. To wire up email collection:
 *
 * OPTION A — ConvertKit (embed form)
 *   1. Create a form in ConvertKit -> "Embed" -> "HTML"
 *   2. Replace the <form>...</form> below with their markup, OR
 *   3. Set action="https://app.convertkit.com/forms/<FORM_ID>/subscriptions"
 *      and keep the markup; ConvertKit accepts POSTs with `email_address`.
 *
 * OPTION B — Buttondown (embed form)
 *   1. Grab your username from https://buttondown.email/settings
 *   2. Set action="https://buttondown.email/api/emails/embed-subscribe/<USERNAME>"
 *   3. The existing `email` field name is already correct.
 *
 * OPTION C — Serverless endpoint (most control)
 *   Point action="/api/subscribe" and create an Astro endpoint
 *   at src/pages/api/subscribe.ts that proxies to the provider's API
 *   using a secret from import.meta.env. Requires output: 'server' or
 *   a Netlify/Vercel adapter.
 *
 * Until you configure one of the above, the form posts to "#" and does nothing.
 * =========================================================================
 */
---

<section class="signup ui" aria-labelledby="signup-heading">
  <h2 id="signup-heading">Get new essays by email</h2>
  <p class="muted">
    Occasional notes on {/* describe your writing in a sentence */}
    work, spirituality, and creativity. No spam, unsubscribe anytime.
  </p>

  <!-- TODO: replace action="#" with your ConvertKit/Buttondown endpoint -->
  <form action="#" method="post" class="signup-form">
    <label class="visually-hidden" for="email">Email address</label>
    <input
      id="email"
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      autocomplete="email"
    />
    <button type="submit">Subscribe</button>
  </form>

  <p class="muted placeholder-notice">
    <em>
      ⚠ Placeholder — form is not yet connected. See
      <code>src/components/EmailSignup.astro</code> for wiring instructions.
    </em>
  </p>
</section>

<style>
  .signup {
    margin: 3rem 0 1rem;
    padding: 1.75rem;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    background: var(--color-paper-warm);
  }

  .signup h2 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-family: var(--font-sans);
    letter-spacing: 0.01em;
  }

  .signup-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .signup-form input[type='email'] {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-family: var(--font-sans);
  }

  .signup-form input[type='email']:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .signup-form button {
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-ink);
    border-radius: 4px;
    background: var(--color-ink);
    color: var(--color-paper);
    font: inherit;
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .signup-form button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .placeholder-notice {
    margin-top: 0.9rem;
    font-size: 0.8rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 600px) {
    .signup {
      padding: 1.25rem;
    }
    .signup-form button {
      flex: 1 1 100%;
    }
  }
</style>
