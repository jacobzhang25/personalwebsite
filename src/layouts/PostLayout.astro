---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, sphere } = post.data;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <p class="post-meta ui muted">
        <time datetime={pubDate.toISOString()}>
          {dateFormatter.format(pubDate)}
        </time>
        <span class="sep">·</span>
        <span class="sphere">{sphere}</span>
        {
          updatedDate && (
            <>
              <span class="sep">·</span>
              <span>
                updated{' '}
                {dateFormatter.format(updatedDate)}
              </span>
            </>
          )
        }
      </p>
      <h1>{title}</h1>
    </header>
    <div class="post-body">
      <slot />
    </div>
    <footer class="post-footer ui">
      <a href="/blog">← Back to writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-meta {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .sep {
    margin: 0 0.5rem;
    color: var(--color-rule);
  }

  .sphere {
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .post-body :global(h2) {
    margin-top: 2.5rem;
  }

  .post-body :global(h3) {
    margin-top: 2rem;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.95rem;
  }

  .post-footer a {
    text-decoration: none;
    color: var(--color-ink-soft);
  }

  .post-footer a:hover {
    color: var(--color-accent);
  }
</style>
